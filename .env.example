DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
FYERS_REDIRECT_URL=http://localhost:8000/fyers/callback/

# The new engine uses the simulated broker by default. Live mode requires both
# TRADING_API_KEY and TRADING_API_SECRET.
TRADING_ENVIRONMENT=development
TRADING_BROKER=simulated
TRADING_ACCOUNT=paper
TRADING_PAPER=true
TRADING_AUDIT_DIRECTORY=var/audit
TRADING_LOG_LEVEL=INFO
# TRADING_API_KEY=
# TRADING_API_SECRET=

# Optional pre-trade limits.
RISK_MAX_ORDER_QUANTITY=1000
RISK_MAX_ORDER_NOTIONAL=1000000
RISK_MAX_POSITION_QUANTITY=5000
RISK_MAX_GROSS_EXPOSURE=5000000
RISK_MAX_NET_EXPOSURE=2500000
RISK_MAX_DAILY_LOSS=100000
RISK_MAX_OPEN_ORDERS=100
RISK_MAX_QUOTE_AGE_SECONDS=30
RISK_PRICE_BAND_PERCENT=10

# Credentials for the optional legacy TrueData adapter. Keep these unset when
# using the dependency-free engine and simulated broker.
# TRUEDATA_USERNAME=
# TRUEDATA_PASSWORD=
TRUEDATA_REALTIME_PORT=8082
TRUEDATA_HISTORY_PORT=8092
BN_FUTURES_CONTRACT=BANKNIFTY22MAYFUT
BANKNIFTY_OPTIONS_PREFIX=NSE:BANKNIFTY22210
BANKNIFTY_OPTIONS_DEPTH=500

# Leave DATABASE_URL unset to use local SQLite.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autodub
